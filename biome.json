{
    "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
    "organizeImports": {
        "enabled": true
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "a11y": {
                "noLabelWithoutControl": "off",
                "noAutofocus": "off",
                "useSemanticElements": "off"
            },
            "correctness": {
                "useExhaustiveDependencies": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "semicolons": "always",
            "quoteStyle": "double",
            "trailingCommas": "es5",
            "bracketSameLine": true
        }
    },
    "files": {
        "include": ["src/**/*", "tests/**/*"],
        "ignore": ["dist", "node_modules"]
    }
}
